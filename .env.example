# Dataset roots. Relative task paths are resolved under DATA_PATH.
DATA_PATH=/path/to/edit-knowledge/data
FICTBIO_PATH=/path/to/FictBio
MQUAKE_PATH=/path/to/MQuAKE
RECOE_PATH=/path/to/ReCoE
MMLU_PATH=/path/to/MMLU/all_subjects.json

# Training/model outputs.
MODEL_PATH=/path/to/model-cache
ADAPTER_PATH=/path/to/adapters
LOGBOOK_PATH=/path/to/logbook

# vLLM inference server and model used by the task scripts.
VLLM_BASE_URL=http://localhost:8000
KNOWLEDGE_EDIT_MODEL=qwen3-32b

# Optional hosted-model providers used by some baselines.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional experiment tracking.
WANDB_API_KEY=
